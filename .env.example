DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATA_DIR=./data
DEFAULT_AUTOPLAY=true
NOW_PLAYING_REFRESH_MS=5000
FFMPEG_PATH=/usr/bin/ffmpeg
PLAYER_DEBUG=false
YTDL_NO_UPDATE=1
YOUTUBE_DL_SKIP_PYTHON_CHECK=1
ENABLE_DIRECT_YTDL_STREAM=false
STRICT_SONG_MODE_DEFAULT=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional custom emojis from your Discord server (the bot must be able to use them).
# Format: <:emoji_name:123456789012345678> or <a:emoji_name:123456789012345678>
# SyncInk emoji IDs below are built in; set a value only to override one.
EMOJI_SYNCINK=
EMOJI_SYNCINK_MUSIC=
EMOJI_PLAY=
EMOJI_PAUSE=
EMOJI_SKIP=
EMOJI_PREVIOUS=
EMOJI_STOP=
EMOJI_QUEUE=
EMOJI_PLAYLIST=
EMOJI_ADDED=
EMOJI_RADIO=
EMOJI_TIME=
EMOJI_HEART=
EMOJI_VOLUME=
EMOJI_MEMBERS=
EMOJI_ARROW=
EMOJI_LOOKING=
EMOJI_APPROVED=
EMOJI_REFUSED=
EMOJI_WARNING=
EMOJI_YOUTUBE=
EMOJI_YOUTUBE_MUSIC=
EMOJI_SOUNDCLOUD=
EMOJI_SPOTIFY=
EMOJI_APPLE_MUSIC=
EMOJI_DEEZER=
EMOJI_TIDAL=
EMOJI_DIRECT_AUDIO=
