# ================================================================
# SyncInk Radio - Configuration
# ================================================================

# Discord Bot Credentials (Required)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=1500567606648897819

# Optional: Instant slash commands sync to a development or primary server
TARGET_GUILD_ID=
DISCORD_GUILD_ID=

# Database Connection (Optional)
# If provided, the bot uses PostgreSQL with auto-migrations.
# If left empty, the bot automatically uses zero-config SQLite stored in ./data/syncink_radio.db.
DATABASE_URL=

# FFmpeg Executable (Optional - defaults to auto-detecting ffmpeg or bundled ffmpeg.exe)
FFMPEG_PATH=

# AI AutoPlay Recommendation Keys (Optional)
# Used by AutoPlay Tier 1 & 2 for hyper-personalized smart song transitions
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Server Restrictions (Leave blank to allow everywhere)
MUSIC_ALLOWED_GUILD_ID=
MUSIC_COMMAND_CHANNEL_ID=
MUSIC_BOOSTER_ROLE_ID=

# Automated GitHub Self-Updater & Auto-Restart (Optional)
# The bot runs a 24/7 background worker that checks GitHub for new commits,
# pulls them silently, and restarts itself in ~3s without manual terminal intervention.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL=60
BOT_OWNER_ID=

# ================================================================
# Spotify Developer API Integration (Phase 2)
# ================================================================
# Registered under Spotify Developer Dashboard (SyncInk Radio):
# Spotify Application Status: Development Mode
# Client ID and Client Secret from developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local development redirect URI or Production HTTPS callback
# MUST match the Redirect URI entered in your Spotify Developer App Settings
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Port for the embedded OAuth callback server (default 8888)
SPOTIFY_CALLBACK_PORT=8888
# Secret encryption key for user refresh tokens (leave blank to auto-derive from bot token)
SPOTIFY_TOKEN_ENCRYPTION_KEY=
